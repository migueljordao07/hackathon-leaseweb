# SkyShift configuration: names only. Copy to .env (git-ignored), fill values privately,
# then load with: set -a; . ./.env; set +a
# Never commit real values. Secrets are delivered to operators out of band.

# Unchanged fixture app (it alone receives these AWS-compatible variables)
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Source: S3-compatible service holding synthetic data (e.g. local moto_server)
SKYSHIFT_SOURCE_ENDPOINT_URL=
SKYSHIFT_SOURCE_ACCESS_KEY_ID=
SKYSHIFT_SOURCE_SECRET_ACCESS_KEY=
SKYSHIFT_SOURCE_BUCKET=

# Target: Leaseweb object storage or a self-hosted S3-compatible service
SKYSHIFT_TARGET_ENDPOINT_URL=
SKYSHIFT_TARGET_ACCESS_KEY_ID=
SKYSHIFT_TARGET_SECRET_ACCESS_KEY=
SKYSHIFT_TARGET_BUCKET=
SKYSHIFT_TARGET_PROVIDER=

# Optional: OpenAI-compatible model endpoint (e.g. Ollama); unset or REPLAY=1 uses labelled replay
SKYSHIFT_LLM_BASE_URL=
SKYSHIFT_LLM_API_KEY=
SKYSHIFT_LLM_MODEL=
SKYSHIFT_LLM_REPLAY=

# Severance drill (telemetry destination and proxy settings)
SKYSHIFT_TELEMETRY_ENDPOINT=
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=

# Provider-specific (only the human-approved provider mode needs these)
OS_AUTH_URL=
OS_APPLICATION_CREDENTIAL_ID=
OS_APPLICATION_CREDENTIAL_SECRET=
OS_REGION_NAME=
LEASEWEB_API_KEY=
