
# {{ source_id }} -> openstack_compute_instance_v2 (template; image/flavor need operator input)
resource "openstack_compute_instance_v2" "{{ label }}" {
  name            = {{ name }}
  image_name      = var.{{ image_var }}
  flavor_name     = var.{{ flavor_var }}
  security_groups = {{ security_groups }}
  metadata        = {{ metadata }}
}
